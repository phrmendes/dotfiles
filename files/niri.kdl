window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id="^\\.blueman-manager-wrapped$"
    open-floating true
}
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
}
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    block-out-from "screen-capture"
}
binds {
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    Mod+Return {
        spawn "kitty"
    }
    Mod+Space {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }
    Mod+B {
        spawn "librewolf"
    }
    Mod+V {
        spawn "noctalia" "msg" "panel-toggle" "clipboard"
    }
    Ctrl+Alt+L {
        spawn "noctalia" "msg" "session" "lock"
    }
    Print {
        spawn "screenshot" "screenshot"
    }
    Mod+Print {
        spawn "screenshot" "screenshot-window"
    }
    Mod+Shift+Print {
        spawn "screenshot" "screenshot-screen"
    }
    Mod+Q {
        close-window
    }
    Mod+Z {
        maximize-column
    }
    Mod+F {
        toggle-window-floating
    }
    Mod+R {
        switch-preset-column-width
    }
    Mod+G {
        toggle-column-tabbed-display
    }
    Mod+Tab {
        toggle-column-tabbed-display
    }
    Mod+T {
        consume-window-into-column
    }
    Mod+H {
        focus-column-left
    }
    Mod+J {
        focus-window-down
    }
    Mod+K {
        focus-window-up
    }
    Mod+L {
        focus-column-right
    }
    Mod+Ctrl+H {
        move-column-left
    }
    Mod+Ctrl+J {
        move-window-down
    }
    Mod+Ctrl+K {
        move-window-up
    }
    Mod+Ctrl+L {
        move-column-right
    }
    Mod+Shift+H {
        set-column-width "-5%"
    }
    Mod+Shift+J {
        set-window-height "+5%"
    }
    Mod+Shift+K {
        set-window-height "-5%"
    }
    Mod+Shift+L {
        set-column-width "+5%"
    }
    Mod+N {
        focus-monitor-next
    }
    Mod+P {
        focus-monitor-previous
    }
    Mod+Shift+N {
        move-window-to-monitor-next
    }
    Mod+Shift+P {
        move-window-to-monitor-previous
    }
    Mod+1 {
        focus-workspace 1
    }
    Mod+Shift+1 {
        move-window-to-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+Shift+2 {
        move-window-to-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+Shift+3 {
        move-window-to-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+Shift+4 {
        move-window-to-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+Shift+5 {
        move-window-to-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+Shift+6 {
        move-window-to-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+Shift+7 {
        move-window-to-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+Shift+8 {
        move-window-to-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Shift+9 {
        move-window-to-workspace 9
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down"
    }
    XF86AudioMute allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "noctalia" "msg" "mic-mute"
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down"
    }
}
