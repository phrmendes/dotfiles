load_plugins {
    vim-zellij-navigator
    "file:~/.config/zellij/plugins/zj_which_key.wasm" {
        auto_show "true"
        delay_secs "1"
        position "bottom-right"
        max_height_pct "90"
    }
}
plugins {
    vim-zellij-navigator location="file:~/.config/zellij/plugins/vim-zellij-navigator.wasm"
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm"
    welcome-screen location="zellij:session-manager" {
        welcome_screen false
    }
}
keybinds clear-defaults=true {
    normal {
        bind "Ctrl Space" {
            SwitchToMode "Tmux"
        }
        bind "Ctrl h" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus_or_tab"
                payload "left"
            }
        }
        bind "Ctrl j" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus"
                payload "down"
            }
        }
        bind "Ctrl k" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus"
                payload "up"
            }
        }
        bind "Ctrl l" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus_or_tab"
                payload "right"
            }
        }
    }
    tmux {
        bind "Ctrl Space" "Esc" {
            SwitchToMode "Normal"
        }
        bind "-" {
            NewPane "Down"
            SwitchToMode "Normal"
        }
        bind "\\" {
            NewPane "Right"
            SwitchToMode "Normal"
        }
        bind "H" {
            Resize "Increase Left"
        }
        bind "J" {
            Resize "Increase Down"
        }
        bind "K" {
            Resize "Increase Up"
        }
        bind "L" {
            Resize "Increase Right"
        }
        bind "z" {
            ToggleFocusFullscreen
            SwitchToMode "Normal"
        }
        bind "Enter" {
            NextSwapLayout
            SwitchToMode "Normal"
        }
        bind "q" {
            CloseFocus
            SwitchToMode "Normal"
        }
        bind "n" {
            NewTab
            SwitchToMode "Normal"
        }
        bind "w" {
            SwitchToMode "Tab"
        }
        bind "[" {
            GoToPreviousTab
            SwitchToMode "Normal"
        }
        bind "]" {
            GoToNextTab
            SwitchToMode "Normal"
        }
        bind "d" {
            Detach
        }
        bind "v" {
            SwitchToMode "Scroll"
        }
        bind "y" {
            EditScrollback
            SwitchToMode "Normal"
        }
        bind "," {
            SwitchToMode "RenameTab"
            TabNameInput 0
        }
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "}" {
            MovePane
            SwitchToMode "Normal"
        }
        bind "{" {
            MovePaneBackwards
            SwitchToMode "Normal"
        }
        bind ">" {
            BreakPane
            SwitchToMode "Normal"
        }
        bind "<" {
            BreakPaneLeft
            SwitchToMode "Normal"
        }
        bind "l" {
            ToggleTab
            SwitchToMode "Normal"
        }
    }
    tab {
        bind "Ctrl Space" "Esc" "q" {
            SwitchToMode "Normal"
        }
        bind "h" "Left" {
            GoToPreviousTab
        }
        bind "l" "Right" {
            GoToNextTab
        }
        bind "Enter" {
            SwitchToMode "Normal"
        }
        bind "n" {
            NewTab
            SwitchToMode "Normal"
        }
        bind "x" {
            CloseTab
            SwitchToMode "Normal"
        }
        bind "1" {
            GoToTab 1
            SwitchToMode "Normal"
        }
        bind "2" {
            GoToTab 2
            SwitchToMode "Normal"
        }
        bind "3" {
            GoToTab 3
            SwitchToMode "Normal"
        }
        bind "4" {
            GoToTab 4
            SwitchToMode "Normal"
        }
        bind "5" {
            GoToTab 5
            SwitchToMode "Normal"
        }
        bind "6" {
            GoToTab 6
            SwitchToMode "Normal"
        }
        bind "7" {
            GoToTab 7
            SwitchToMode "Normal"
        }
        bind "8" {
            GoToTab 8
            SwitchToMode "Normal"
        }
        bind "9" {
            GoToTab 9
            SwitchToMode "Normal"
        }
    }
    renametab {
        bind "Enter" "Ctrl c" {
            SwitchToMode "Normal"
        }
        bind "Esc" {
            UndoRenameTab
            SwitchToMode "Normal"
        }
    }
    scroll {
        bind "Ctrl Space" "q" {
            SwitchToMode "Normal"
        }
        bind "j" "Down" {
            ScrollDown
        }
        bind "k" "Up" {
            ScrollUp
        }
        bind "Ctrl d" {
            HalfPageScrollDown
        }
        bind "Ctrl u" {
            HalfPageScrollUp
        }
        bind "Ctrl f" {
            PageScrollDown
        }
        bind "Ctrl b" {
            PageScrollUp
        }
        bind "g" {
            ScrollToTop
        }
        bind "G" {
            ScrollToBottom
        }
        bind "/" {
            SwitchToMode "EnterSearch"
            SearchInput 0
        }
    }
    entersearch {
        bind "Ctrl c" "Esc" {
            SwitchToMode "Scroll"
        }
        bind "Enter" {
            SwitchToMode "Search"
        }
    }
    search {
        bind "Ctrl Space" "Esc" "q" {
            SwitchToMode "Normal"
        }
        bind "j" "Down" {
            ScrollDown
        }
        bind "k" "Up" {
            ScrollUp
        }
        bind "n" {
            Search "down"
        }
        bind "N" {
            Search "up"
        }
        bind "Enter" {
            SwitchToMode "Normal"
        }
    }
}
